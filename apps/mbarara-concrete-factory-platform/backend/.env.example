ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://<database_user>:<database_password>@localhost:5432/mbarara_factory
AUTO_CREATE_TABLES=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
API_SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
BOOTSTRAP_OWNER_SETUP_KEY=replace-with-private-one-time-owner-setup-key
